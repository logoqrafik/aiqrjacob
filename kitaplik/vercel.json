{
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/quotes.js": {
      "maxDuration": 60
    },
    "api/cover.js": {
      "maxDuration": 20
    },
    "api/portrait.js": {
      "maxDuration": 20
    },
    "api/keepalive.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    }
  ]
}
